# Database (Postgres, e.g. Neon / Supabase / Vercel Postgres - all work well with Vercel deployments)
DATABASE_URL="postgresql://user:password@host:5432/tovarkaduck"

# Auth for admin panel
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# Store
NEXT_PUBLIC_SITE_URL="https://tovarkaduck.com"
NEXT_PUBLIC_STORE_CURRENCY="UAH"

# Analytics / Google Ads (fill in once accounts exist)
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# Object storage for product images (fill in once a provider is chosen)
BLOB_READ_WRITE_TOKEN=""

# Payment provider (left empty on purpose in MVP - see src/server/adapters/payments)
PAYMENT_PROVIDER_API_KEY=""

# Nova Poshta (left empty on purpose in MVP - see src/server/adapters/shipping)
NOVA_POSHTA_API_KEY=""
